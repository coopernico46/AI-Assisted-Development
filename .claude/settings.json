{
    "enableAllProjectMcpServers": true,
    "enabledMcpjsonServers": ["playwright"],
    "statusLine": {
        "type": "command",
        "command": "python3 .claude/scripts/status_line.py"
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 .claude/scripts/enforce_constitution.py"
                    }
                ]
            }
        ]
    }
}
